{
  "name": "@ssr-deno/vite-react-mui-ssr-app",
  "version": "1.0.0",
  "exports": "./serve.deno.ts",
  "lock": "deno.lock",
  "nodeModulesDir": "auto",
  "exclude": [
    "dist/",
    "node_modules/"
  ],
  "tasks": {
    "build": "deno run --unstable-bare-node-builtins -A npm:vite build --ssr",
    "serve": "deno run --allow-read --allow-net --allow-env serve.deno.ts"
  },
  "imports": {
    "react": "npm:react@^19.3.1",
    "react-dom": "npm:react-dom@^19.3.1",
    "react/jsx-runtime": "npm:react@^19.3.1/jsx-runtime",
    "react-dom/server": "npm:react-dom@^19.3.1/server",
    "@emotion/react": "npm:@emotion/react@^11.14.0",
    "@emotion/styled": "npm:@emotion/styled@^11.14.1",
    "@emotion/cache": "npm:@emotion/cache@^11.14.0",
    "@mui/material": "npm:@mui/material@^9.5.0",
    "@mui/icons-material": "npm:@mui/icons-material@^9.5.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.2",
    "vite": "npm:vite@^8.3.5",
    "@types/deno": "npm:@types/deno@^2.7.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "npm:@types/deno",
      "npm:@types/react@^19.3.0",
      "npm:@types/react-dom@^19.3.0"
    ]
  }
}
